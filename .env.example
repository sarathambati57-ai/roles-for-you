# Public Supabase project values (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only key, used ONLY in server code (never shipped to the browser).
# Needed for admin actions that must bypass RLS is NOT required if you follow
# the RLS policies in supabase/schema.sql (admin writes go through the
# authenticated Supabase session instead). Keep this here only if you later
# add server-side admin utilities that need it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Base URL of your deployed site, used for canonical URLs / OG tags / sitemaps
NEXT_PUBLIC_SITE_URL=https://rolesforyou.in
